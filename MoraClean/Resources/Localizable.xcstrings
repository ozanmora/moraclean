        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamaların yeniden oluşturabildiği geçici dosyalar (~/Library/Caches)"
          }
        }
      }
    },
    "The app could not be quit. Quit it and try again.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama kapatılamadı. Kapatıp tekrar deneyin."
          }
        }
      }
    },
    "The app expects an EdDSA signature but the update has none; it was not installed for safety.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama EdDSA imzası bekliyor ama güncellemede imza yok; güvenlik nedeniyle kurulmadı."
          }
        }
      }
    },
    "The appcast has no download link.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appcast'te indirme bağlantısı yok."
          }
        }
      }
    },
    "The archive contains no app with the same bundle identifier.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivde aynı paket kimliğine sahip uygulama bulunamadı."
          }
        }
      }
    },
    "The developer identity does not match (expected %@, found %@); it was not installed.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geliştirici kimliği uyuşmuyor (beklenen %@, bulunan %@); kurulmadı."
          }
        }
      }
    },
    "The downloaded file has an invalid EdDSA signature; it was not installed for safety.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilen dosyanın EdDSA imzası geçersiz; güvenlik nedeniyle kurulmadı."
          }
        }
      }
    },
    "The installer package was opened in Installer; complete the steps there.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulum paketi Yükleyici'de açıldı; adımları orada tamamlayın."
          }
        }
      }
    },
    "The new language is applied after a restart.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni dil, uygulama yeniden başlatılınca uygulanır."
          }
        }
      }
    },
