    "%lld selected items will be deleted permanently. This cannot be undone.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld selected item will be deleted permanently. This cannot be undone."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld selected items will be deleted permanently. This cannot be undone."
                }
              }
            }
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen %lld öğe kalıcı olarak silinecek. Bu işlem geri alınamaz."
          }
        }
      }
    },
    "%lld selected items will be moved to the Trash. The space is freed when you empty the Trash.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld selected item will be moved to the Trash. The space is freed when you empty the Trash."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld selected items will be moved to the Trash. The space is freed when you empty the Trash."
                }
              }
            }
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen %lld öğe Çöp Kutusuna taşınacak. Alan, Çöp Kutusu boşaltılınca açılır."
          }
        }
      }
    },
