    "Finds updates from Homebrew, the Mac App Store and Sparkle feeds.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew, Mac App Store ve Sparkle akışlarından güncellemeleri bulur."
          }
        }
      }
    },
    "For protected locations such as the Trash, allow MoraClean in System Settings > Privacy & Security > Full Disk Access, then restart the app.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp Kutusu gibi korunan alanlar için Sistem Ayarları > Gizlilik ve Güvenlik > Tam Disk Erişimi'nden MoraClean'e izin verin, ardından uygulamayı yeniden başlatın."
          }
        }
      }
    },
    "Found %@ of unneeded files.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gereksiz dosya bulundu."
          }
        }
